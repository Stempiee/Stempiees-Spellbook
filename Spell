local DROP_POS = Vector3.new(-2278.31, 6.06, 4385.85)
local CLICK1_X, CLICK1_Y = 1176, 457
local CLICK2_X, CLICK2_Y = 1161, 887

local VK_F, VK_E = 0x46, 0x45
local HOLD_TIME, BAG_COUNT = 4, 3
local BAG_HOVER = 5
local BAG_PIN = 3.0
local BAG_DESCEND = 0.8
local GROUND_PIN = 0.5
local REPIN = 0.2
local BETWEEN, DROP_WAIT, SELL_WAIT = 0.3, 1.0, 1.2
local E_HOLD, CLICK_WAIT, CLICK_GAP = 0.1, 0.3, 0.3
local MOVE_TIME, MOVE_STEPS = 0.25, 25
local PROMPT_WAIT, RUNALL_GAP = 0.15, 0.5
local BAG_CAM_DOWN, SELL_HOVER = 12, 0
local JIGGLE_PX, JIGGLE_STEPS = 3, 8
local CLICK_COUNT, CLICK_DELAY = 3, 0.15

local stopRequested = false

local function setCamera(down)
    down = down or 0
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local cam
    pcall(function() cam = WS.CurrentCamera end)
    if not cam then return end
    local look = root.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
    flat = flat.Unit
    local camPos = root.Position - flat * 8 + Vector3.new(0, 4 + down, 0)
    local target = root.Position - Vector3.new(0, down * 0.8, 0)
    pcall(function() cam.lookAt(camPos, target) end)
end

local function resetHumanoid()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
end

local function pinAt(pos, hover, duration)
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local target = CFrame.new(pos.X, pos.Y + hover, pos.Z)
    local start = tick()
    while tick() - start < duration do
        pcall(function()
            root.CFrame = target
            root.Velocity = Vector3.new(0, 0, 0)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
        resetHumanoid()
        wait()
    end
    return true
end

local function descend(pos, fromHover, duration, steps)
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    for i = 0, steps do
        local a = i / steps
        local h = fromHover * (1 - a)
        pcall(function()
            root.CFrame = CFrame.new(pos.X, pos.Y + h, pos.Z)
            root.Velocity = Vector3.new(0, 0, 0)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
        resetHumanoid()
        wait(duration / steps)
    end
end

local function bagTeleport(pos)
    if not pinAt(pos, BAG_HOVER, BAG_PIN) then return false end
    descend(pos, BAG_HOVER, BAG_DESCEND, 30)
    pinAt(pos, 0, GROUND_PIN)
    return true
end

local function teleport(pos, settle, hover)
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local target = CFrame.new(pos.X, pos.Y + (hover or 0), pos.Z)
    local ok = pcall(function() root.CFrame = target end)
    if not ok then return false end
    local start = tick()
    while tick() - start < (settle or 1.0) do
        pcall(function()
            root.CFrame = target
            root.Velocity = Vector3.new(0, 0, 0)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
        resetHumanoid()
        wait()
    end
    return true
end

local function smoothMove(tx, ty)
    local sx, sy = mouse.X, mouse.Y
    for i = 1, MOVE_STEPS do
        local a = i / MOVE_STEPS
        mousemoveabs(math.floor(sx + (tx - sx) * a), math.floor(sy + (ty - sy) * a))
        wait(MOVE_TIME / MOVE_STEPS)
    end
    mousemoveabs(tx, ty)
end

local function jiggleClick(tx, ty)
    for i = 1, JIGGLE_STEPS do
        mousemoveabs(tx + math.random(-JIGGLE_PX, JIGGLE_PX), ty + math.random(-JIGGLE_PX, JIGGLE_PX))
        wait(0.02)
    end
    mousemoveabs(tx, ty)
    wait(0.05)
    for i = 1, CLICK_COUNT do
        mouse1click()
        wait(CLICK_DELAY)
    end
end

local function doLocation(pos)
    if not bagTeleport(pos) then return end
    setCamera(BAG_CAM_DOWN)
    wait(PROMPT_WAIT)
    setCamera(BAG_CAM_DOWN)
    wait(PROMPT_WAIT)

    for i = 1, BAG_COUNT do
        if stopRequested then return end
        pinAt(pos, 0, REPIN)
        keypress(VK_F)
        wait(HOLD_TIME)
        keyrelease(VK_F)
        if i < BAG_COUNT then wait(BETWEEN) end
    end

    if stopRequested then return end
    setCamera(0)
    wait(PROMPT_WAIT)
    teleport(DROP_POS, DROP_WAIT, SELL_HOVER)
    if stopRequested then return end
    wait(SELL_WAIT)
    keypress(VK_E)
    wait(E_HOLD)
    keyrelease(VK_E)
    wait(CLICK_WAIT)
    smoothMove(CLICK1_X, CLICK1_Y)
    wait(0.05)
    jiggleClick(CLICK1_X, CLICK1_Y)
    if stopRequested then return end
    wait(CLICK_GAP)
    smoothMove(CLICK2_X, CLICK2_Y)
    wait(0.05)
    jiggleClick(CLICK2_X, CLICK2_Y)
end

local busy = false

local function runAll()
    if busy then return end
    busy = true
    stopRequested = false
    pcall(function()
        for i, pos in ipairs(presets) do
            if stopRequested then break end
            doLocation(pos)
            if i < #presets and not stopRequested then wait(RUNALL_GAP) end
        end
    end)
    busy = false
    stopRequested = false
    warn("Stopped")
end

