local runX1, runY1 = PX + PAD, btnY
local runX2, runY2 = runX1 + runW, btnY + BTN_H
local stopX1, stopY1 = stopX, btnY
local stopX2, stopY2 = stopX + STOP_W, btnY + BTN_H

local runHovered, stopHovered = false, false
local wasDown = false

task.spawn(function()
    while true do
        local mx, my = mouse.X, mouse.Y
        local hRun  = (mx >= runX1 and mx <= runX2 and my >= runY1 and my <= runY2)
        local hStop = (mx >= stopX1 and mx <= stopX2 and my >= stopY1 and my <= stopY2)

        if hRun ~= runHovered then
            runHovered = hRun
            runBG.Color     = hRun and COL_BTN_HV or COL_BTN
            runStripe.Color = hRun and COL_ACCENT2 or COL_ACCENT
            runLbl.Color    = hRun and COL_ACCENT2 or COL_TEXT
        end
        if hStop ~= stopHovered then
            stopHovered = hStop
            stopBG.Color  = hStop and COL_STOP_HV or COL_STOP
            stopLbl.Color = hStop and Color3.fromRGB(255, 220, 220) or COL_STOP_T
        end

        local down = ismouse1pressed()
        if down and not wasDown then
            if hRun then task.spawn(runAll) end
            if hStop then stopRequested = true end
        end
        wasDown = down
        wait()
    end
end)
